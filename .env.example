# ---------------------------------------------------------------------------
# Copiar a .env y ajustar. El repo ya trae un .env con estos mismos valores
# para que `docker compose up` funcione sin pasos previos.
# ---------------------------------------------------------------------------

APP_ENV=dev
LOG_LEVEL=info

# --- Base de datos ---------------------------------------------------------
POSTGRES_USER=dental
POSTGRES_PASSWORD=dental
POSTGRES_DB=dental
# Dentro de docker-compose el host lo sobreescribe el propio compose a "db".
# Este valor es el que sirve para correr alembic/pytest desde el host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Alternativa: URL completa que gana sobre las variables de arriba.
# DATABASE_URL=postgresql+asyncpg://dental:dental@localhost:5432/dental
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Autenticacion ---------------------------------------------------------
# CAMBIAR en cualquier entorno que no sea local.
SECRET_KEY=dev-secret-change-me-0123456789abcdef0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# OJO en pruebas de carga: bcrypt es CPU-bound a proposito. Con 12 rondas un
# login cuesta ~250 ms y domina cualquier medicion del endpoint. Para medir el
# resto de la API, bajar a 4-6, o loguearse una vez y reutilizar el token.
BCRYPT_ROUNDS=12

# Token estatico para /admin/* (caos). CAMBIAR fuera de local.
ADMIN_TOKEN=dev-admin-token-change-me

# Si ambas estan definidas, al arrancar se crea este admin si no existe.
BOOTSTRAP_ADMIN_EMAIL=admin@dental.local
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# --- Reglas de negocio -----------------------------------------------------
MIN_APPOINTMENT_MINUTES=15
MAX_APPOINTMENT_MINUTES=240
# Poner en true si el generador de carga va a mandar fechas pasadas.
ALLOW_PAST_APPOINTMENTS=false

# Horario de atencion, usado por GET /dentists/{id}/availability.
# Se interpreta en CLINIC_TIMEZONE; la API responde en UTC de todas formas.
CLINIC_TIMEZONE=America/Santiago
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18
DEFAULT_SLOT_MINUTES=30

# --- Servidor --------------------------------------------------------------
# 1 worker por defecto: el estado del caos y las metricas viven por proceso.
WORKERS=1
RELOAD=false
# El access log de uvicorn cuesta throughput; apagarlo al medir.
ACCESS_LOG=true
API_PORT=8000
# Puerto de la segunda instancia, la que arranca con el caos encendido.
API_CHAOS_PORT=8001

# --- Observabilidad --------------------------------------------------------
METRICS_ENABLED=true

# ---------------------------------------------------------------------------
# CAOS: latencia y errores inyectados.
# Estos valores son solo el estado INICIAL; se cambian en caliente con
#   curl -X PUT localhost:8000/admin/chaos -H "X-Admin-Token: $ADMIN_TOKEN" ...
# ---------------------------------------------------------------------------
CHAOS_ENABLED=false
CHAOS_LATENCY_MS=0
CHAOS_LATENCY_JITTER_MS=0
CHAOS_ERROR_RATE=0.0
CHAOS_ERROR_STATUS=503
# Lista separada por comas, patrones estilo glob sobre el path.
# Ej: /api/v1/appointments*,/api/v1/auth/login
CHAOS_ROUTES=*
