# ---------------------------------------------------------------------------
# Solo las perillas que diferencian la instancia CON CAOS (localhost:8001) de
# la limpia (localhost:8000). Se aplica encima de .env, no lo reemplaza.
#
# Editar este archivo y reiniciar:
#     docker compose up -d api-chaos
#
# O cambiarlo en caliente, sin reiniciar nada:
#     curl -X PUT localhost:8001/admin/chaos \
#       -H "X-Admin-Token: dev-admin-token-change-me" \
#       -H "Content-Type: application/json" \
#       -d '{"error_rate":0.25,"latency_ms":400}'
#
# Para volver a estos valores:
#     curl -X POST localhost:8001/admin/chaos/reset -H "X-Admin-Token: ..."
# ---------------------------------------------------------------------------

CHAOS_ENABLED=true

# 150 ms de retardo base con +/- 75 ms de variacion: suficiente para que se
# note en el p95 sin tapar por completo el costo real de la API.
CHAOS_LATENCY_MS=150
CHAOS_LATENCY_JITTER_MS=75

# 1 de cada 10 requests corta con 503. Ojo en k6: este 503 NO es un fallo de
# la API, es el inyectado; viene con el header X-Chaos-Injected: error.
CHAOS_ERROR_RATE=0.10
CHAOS_ERROR_STATUS=503

# Solo la API de negocio. /admin, /metrics, /health y /docs quedan exentos
# siempre, por codigo: si no, no habria forma de apagar el caos.
CHAOS_ROUTES=/api/v1/*

# Esta instancia es el blanco de carga: sin access log, que cuesta throughput.
ACCESS_LOG=false
